# VARIÁVEIS DO FRONT-END (Vite)
# ======================================
# Copie para .env.local e ajuste. Só variáveis com prefixo VITE_ chegam
# ao navegador — e tudo que chega lá é público, então nunca coloque
# segredo aqui.

# Endereço da API.
# Em desenvolvimento, deixe comentado: o proxy do vite.config.ts
# encaminha /api para http://localhost:3001 e evita CORS.
# VITE_API_URL=https://gestaopro-api-wthk.onrender.com/api
