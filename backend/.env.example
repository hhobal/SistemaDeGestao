# ======================================
# GESTIQ BACKEND — VARIÁVEIS DE AMBIENTE
# ======================================
# Copie para ".env" e preencha. O .env real nunca vai para o git.

# ─── BANCO DE DADOS (PostgreSQL) ───────
# Em produção usamos Supabase. O painel entrega as duas strings em:
# Connect > ORMs.
#
#   DATABASE_URL → pooler transaction (porta 6543) — usado pela aplicação
#   DIRECT_URL   → pooler session     (porta 5432) — usado pelas migrations
#
# O sufixo ?pgbouncer=true é obrigatório na primeira: sem ele o Prisma
# tenta usar prepared statements, que o pooler não suporta.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USUARIO:SENHA@HOST.pooler.supabase.com:5432/postgres"

# ─── SERVIDOR ──────────────────────────
PORT=3001
NODE_ENV=development

# ─── AUTENTICAÇÃO (JWT) ────────────────
# Gere cada um com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use valores DIFERENTES em desenvolvimento e produção.
JWT_SECRET="troque-por-uma-string-aleatoria-longa"
JWT_EXPIRES_IN="8h"

# Segredo separado para clientes da loja: garante que um token da loja
# nunca abra rota administrativa.
JWT_LOJA_SECRET="troque-por-outra-string-aleatoria-diferente-da-de-cima"
JWT_LOJA_EXPIRES_IN="30d"

# ─── CORS ──────────────────────────────
# Origens autorizadas a chamar esta API, separadas por vírgula.
# O curinga cobre os deploys de preview, que ganham endereço novo a
# cada push, e não atravessa ponto; ver config/cors.js.
#
# É ORIGEM, NÃO DOMÍNIO
#
# O navegador manda `Origin: https://gestiq.vercel.app`, com esquema,
# e config/cors.js compara a string inteira. Hostname sozinho não casa
# com coisa nenhuma:
#
#   errado   gestiq.vercel.app
#   certo    https://gestiq.vercel.app
#
# Nos campos do Render e da Vercel o valor é texto cru, então nada de
# aspas em volta — ali elas entrariam como parte da origem. Neste
# arquivo são inofensivas: o dotenv as remove na leitura.
#
# Errar o formato não desliga a verificação, piora ela: a lista não
# fica vazia, o código não cai no "libera geral" e a API recusa tudo,
# inclusive o próprio site. O único sintoma é erro de CORS no console
# do navegador — cors.js recusa em silêncio, de propósito, para não
# encher o log com ruído de terceiros.
#
# Em produção vai o domínio do painel mais o curinga dos previews:
#
#   https://gestiq.vercel.app,https://gestiq-*.vercel.app
#
# Trocar o nome do projeto na Vercel muda o prefixo dos previews
# junto, e o curinga antigo passa a recusá-los.
CORS_ORIGINS="http://localhost:5500,http://127.0.0.1:5500"

# ─── BANCO DE TESTES ───────────────────
# PostgreSQL local e descartável (docker compose up -d na raiz).
# A suíte se recusa a rodar se isto apontar para um banco remoto.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5434/gestiq_test"

# ─── USUÁRIO ADMINISTRADOR INICIAL ─────
# Usado apenas pelo prisma/seed.js.
SEED_ADMIN_USUARIO="admin"
SEED_ADMIN_SENHA="admin123"
SEED_ADMIN_NOME="Administrador"
