# ======================================
# GESTÃOPRO BACKEND — VARIÁVEIS DE AMBIENTE
# ======================================
# Copie este arquivo para ".env" e ajuste os valores.
# NUNCA suba o arquivo ".env" real para o git (já está no .gitignore).

# ─── BANCO DE DADOS ────────────────────
# Desenvolvimento (SQLite — arquivo único, não precisa instalar nada):
DATABASE_URL="file:./dev.db"

# Produção no servidor da empresa (PostgreSQL) — exemplo:
# DATABASE_URL="postgresql://usuario:senha@localhost:5432/gestaopro?schema=public"

# ─── SERVIDOR ──────────────────────────
PORT=3000
NODE_ENV=development

# ─── AUTENTICAÇÃO (JWT) ────────────────
# Troque por uma string longa e aleatória em produção.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-esta-chave-por-uma-bem-aleatoria-antes-de-usar-em-producao"
JWT_EXPIRES_IN="8h"

# Token separado para clientes da loja (mantém os dois sistemas isolados)
JWT_LOJA_SECRET="troque-esta-tambem-por-outra-chave-aleatoria-diferente-da-de-cima"
JWT_LOJA_EXPIRES_IN="30d"

# ─── CORS ──────────────────────────────
# Endereços do front-end que podem chamar esta API, separados por vírgula.
# Em desenvolvimento local, o Live Server do VSCode normalmente usa 5500/5501.
CORS_ORIGINS="http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501"

# ─── USUÁRIO ADMINISTRADOR INICIAL ─────
# Usado apenas pelo script de seed (prisma/seed.js) na primeira execução.
SEED_ADMIN_USUARIO="admin"
SEED_ADMIN_SENHA="admin123"
SEED_ADMIN_NOME="Administrador"
